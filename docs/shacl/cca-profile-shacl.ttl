  sh:targetClass dct:RightsStatement ;
  sh:name "RightsStatement" ;
  sh:property [ sh:path schema:description ; sh:name "description" ; sh:nodeKind sh:Literal ] .

ccash:CatalogShape a sh:NodeShape ;
  sh:targetClass dcat:Catalog ;
  sh:name "Catalog" ;
  sh:property [ sh:path schema:name ; sh:name "name" ; sh:nodeKind sh:Literal ] ;
  sh:property [ sh:path schema:description ; sh:name "description" ; sh:nodeKind sh:Literal ] ;
  sh:property [ sh:path citedcat:hostingInstitution ; sh:name "hostingInstitution" ; sh:nodeKind sh:IRI ; sh:class schema:Organisation ] .

ccash:DataServiceShape a sh:NodeShape ;
  sh:targetClass dcat:DataService ;
  sh:name "DataService" ;
  sh:property [ sh:path schema:name ; sh:name "name" ; sh:nodeKind sh:Literal ] ;
  sh:property [ sh:path schema:description ; sh:name "description" ; sh:nodeKind sh:Literal ] ;
  sh:property [ sh:path dcat:endpointURL ; sh:name "endpointURL" ; sh:nodeKind sh:Literal ] .

