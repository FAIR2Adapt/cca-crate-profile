  sh:targetClass dpv:TechnicalOrganisationalMeasure ;
  sh:name "TechnicalOrganisationalMeasure" ;
  sh:property [ sh:path schema:name ; sh:name "name" ; sh:nodeKind sh:Literal ] ;
  sh:property [ sh:path schema:description ; sh:name "description" ; sh:nodeKind sh:Literal ] .

ccash:CreativeWorkShape a sh:NodeShape ;
  sh:targetClass schema:CreativeWork ;
  sh:name "Creative Work" ;
