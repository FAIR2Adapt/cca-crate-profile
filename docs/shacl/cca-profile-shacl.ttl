  sh:targetClass schema:Organisation ;
  sh:name "Organisation" ;
  sh:property [ sh:path schema:name ; sh:name "name" ; sh:nodeKind sh:Literal ] .

ccash:GrantShape a sh:NodeShape ;
  sh:targetClass schema:Grant ;
  sh:name "Grant" ;
  sh:property [ sh:path schema:funder ; sh:name "funder" ; sh:nodeKind sh:IRI ; sh:class schema:Organisation ] ;
  sh:property [ sh:path schema:name ; sh:name "name" ; sh:nodeKind sh:Literal ] ;
  sh:property [ sh:path schema:url ; sh:name "url" ; sh:nodeKind sh:Literal ] ;
  sh:property [ sh:path schema:identifier ; sh:name "identifier" ; sh:nodeKind sh:Literal ] .

ccash:StandardShape a sh:NodeShape ;
  sh:targetClass dct:Standard ;
  sh:name "Standard" ;
  sh:property [ sh:path schema:name ; sh:name "name" ; sh:nodeKind sh:Literal ] .

ccash:SensitivityLevelShape a sh:NodeShape ;
  sh:targetClass dpv:SensitivityLevel ;
  sh:name "SensitivityLevel" ;
  sh:property [ sh:path schema:name ; sh:name "name" ; sh:nodeKind sh:Literal ] .

ccash:DisasterRecoveryProceduresShape a sh:NodeShape ;
  sh:targetClass dpv:DisasterRecoveryProcedures ;
  sh:name "DisasterRecoveryProcedures" ;
  sh:property [ sh:path schema:name ; sh:name "name" ; sh:nodeKind sh:Literal ] ;
  sh:property [ sh:path schema:description ; sh:name "description" ; sh:nodeKind sh:Literal ] .

ccash:AccessControlMethodShape a sh:NodeShape ;
  sh:targetClass dpv:AccessControlMethod ;
  sh:name "AccessControlMethod" ;
  sh:property [ sh:path schema:name ; sh:name "name" ; sh:nodeKind sh:Literal ] ;
  sh:property [ sh:path schema:description ; sh:name "description" ; sh:nodeKind sh:Literal ] .

